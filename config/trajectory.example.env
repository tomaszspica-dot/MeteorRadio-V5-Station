# MeteorRadio 3D Trajectory Analyzer
#
# Create:
#
#   /etc/default/meteorradio-trajectory
#
# and place your real receiver coordinates there.
#
# Do NOT commit local station coordinates.

METEORRADIO_RX_LAT=YOUR_LATITUDE
METEORRADIO_RX_LON=YOUR_LONGITUDE

# Receiver altitude above mean sea level, kilometres.
METEORRADIO_RX_ALT_KM=0.000

# GRAVES public-reference defaults are built in.
# Optional overrides:
#
# METEORRADIO_TX_LAT=47.3480
# METEORRADIO_TX_LON=5.5151
