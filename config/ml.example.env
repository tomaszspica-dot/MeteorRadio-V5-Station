# Optional MeteorRadio ML v1 overrides
MR_ML_PORT=8101
MR_ML_STATE_DIR=/home/pi/meteorradio-ml-state
MR_RADAR_DIR=/home/pi/radar_data
MR_SCORE_INDEX=/home/pi/meteorradio-web/cache/v562_score_index.json
MR_CLASSIFICATION_URL=http://127.0.0.1:8094/api/classification
MR_IMAGE_URL=http://127.0.0.1:8096/image
MR_ML_UNKNOWN_THRESHOLD=0.70
MR_ML_MIN_CLASS=5
# 0 means unlimited; worker processes only files lacking a prediction for current model.
MR_ML_MAX_PER_RUN=0
