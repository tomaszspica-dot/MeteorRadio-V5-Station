[Unit]
Description=MeteorRadio V5 background pre-render cache
After=network.target meteorradio-web.service
Wants=meteorradio-web.service

[Service]
Type=simple
User=pi
Group=pi

ExecStart=/usr/bin/python3 -u /home/pi/meteorradio-web/pre_render_cache.py

Restart=always
RestartSec=10

Nice=19
IOSchedulingClass=idle
CPUWeight=10

NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
